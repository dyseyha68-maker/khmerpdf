msgid "Reduce PDF file size"
msgstr "កាត់បន្ថយទំហំឯកសារ PDF"

msgid "Combine multiple PDFs"
msgstr "បញ្ចូល PDF ច្រើនចូលគ្នា"

msgid "Extract pages"
msgstr "ទាញយកទំព័រ"

msgid "Organize PDF"
msgstr "រៀបចំ PDF តាមលំដាប់លំដោយ"

msgid "Reorder pages"
msgstr "រៀបទំព័រឡើងវិញ"

msgid "PDF to Image"
msgstr "PDF ទៅរូបភាព"

msgid "Convert PDF to images"
msgstr "បម្លែង PDF ទៅរូបភាព"

msgid "Image to PDF"
msgstr "បម្លែងរូបភាពទៅ PDF"

msgid "Convert images to PDF"
msgstr "បម្លែងរូបភាពទៅ PDF"

msgid "OCR"
msgstr "កម្មវិធីបំលែងទៅជាអក្សរ"

msgid "Make scanned PDF searchable"
msgstr "នឹងធ្វើឱ្យ PDF ដែលស្កេនអាចស្វែងរកបាន"

msgid "Cambodia holidays"
msgstr "ថ្ងៃឈប់សម្រាក"

