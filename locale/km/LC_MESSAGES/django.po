# --- Tool pages ---
msgid "Select PDF files or drop here"
msgstr "ជ្រើសរើសឯកសារ PDF ឬទំលាក់នៅទីនេះ"

msgid "Select PDF file or drop here"
msgstr "ជ្រើសរើសឯកសារ PDF ឬទំលាក់នៅទីនេះ"

msgid "Select PDF file"
msgstr "ជ្រើសរើសឯកសារ PDF"

msgid "Select images or drop here"
msgstr "ជ្រើសរើសរូបភាព ឬទំលាក់នៅទីនេះ"

msgid "Compression Quality"
msgstr "គុណភាពបង្រួម"

msgid "Low (Best)"
msgstr "កម្រិតទាប (បង្រួមខ្លាំង)"

msgid "Smallest file size, lower quality"
msgstr "កម្រិតទំហំតូចបំផុត គុណភាពទាប"

msgid "Recommended (Balanced)"
msgstr "ណែនាំ (ល្មម)"

msgid "Good balance between size and quality"
msgstr "គុណភាពល្អរវាងកម្រិតទំហំ និងគុណភាព"

msgid "High (Best Quality)"
msgstr "កម្រិតខ្ពស់ (គុណភាពល្អបំផុត)"

msgid "Best quality, larger file size"
msgstr "គុណភាពល្អបំផុត ទំហំធំជាង"

msgid "Estimated output: Calculating..."
msgstr "ទំហំប៉ារម៉ាស់: កំពុងគណនា..."

msgid "Compress PDF"
msgstr "បង្រួម PDF"

msgid "👆 Add PDF files and click Compress."
msgstr "👆 បន្ថែមឯកសារ ហើយចុច Compress"

msgid "Compressing PDF files..."
msgstr "កំពុងបង្រួម PDF..."

msgid "Merge PDF"
msgstr "បញ្ចូល PDF"

msgid "👆 Add PDF files to merge. Click Merge to combine them."
msgstr "👆 បន្ថែមឯកសារ PDF ដើម្បីបញ្ជូល ចុច Merge ដើម្បីបញ្ជូលគ្នា"

msgid "Merging PDF files..."
msgstr "កំពុងបញ្ជូល PDF..."

msgid "Split PDF"
msgstr "បំបែក PDF"

msgid "Split Mode"
msgstr "ទម្រង់សម្រាប់ការបំបែក"

msgid "Select Pages"
msgstr "ជ្រើសរើសទំព័រ"

msgid "Click pages to extract"
msgstr "ចុចទំព័រដើម្បីទាញយក"

msgid "By Range"
msgstr "តាមចន្លោះ"

msgid "Specify page ranges"
msgstr "កំណត់ចន្លោះទំព័រ"

msgid "Split Every N Pages"
msgstr "បំបែកតាមចំនួនទំព័រ"

msgid "Split into files of N pages"
msgstr "បំបែកចំនួនទំព័រក្នុងមួយឯកសារ"

msgid "Page Ranges"
msgstr "ចន្លោះទំព័រ"

msgid "+ Add Another Range"
msgstr "+ បន្ថែមចន្លោះ"

msgid "Split every"
msgstr "បំបែកតាម"

msgid "pages"
msgstr "ទំព័រ"

msgid "Selected:"
msgstr "បានជ្រើស:"

msgid "Total:"
msgstr "សរុប:"

msgid "👆 Click on the PDF file to load pages, then select pages to extract"
msgstr "👆 ចុចលើឯកសារ PDF ភ្ជាប់ទំព័រ រួចជ្រើសទំព័រដែលចង់ទាញយក"

msgid "Actions"
msgstr "សកម្មភាព"

msgid "Select All"
msgstr "ជ្រើសទាំងអស់"

msgid "Deselect All"
msgstr "មិនជ្រើស"

msgid "Add Blank Page"
msgstr "បន្ថែមទំព័រទទេ"

msgid "Replace Selected"
msgstr "ជំនួសទំព័រជ្រើស"

msgid "Delete Selected"
msgstr "លុបចេញ"

msgid "Extract Selected Pages"
msgstr "ទាញយកទំព័រជ្រើស"

msgid "👆 Upload a PDF to reorder pages. Drag pages to rearrange. Click to select/deselect."
msgstr "👆 បញ្ចូល PDF ដើម្បីរៀបចំទំព័រ ទាញទំព័រដើម្បីផ្លាស់ទី ចុចដើម្បីជ្រើស/មិនជ្រើស"

msgid "No PDF loaded"
msgstr "មិនទាន់មាន PDF"

msgid "Processing..."
msgstr "កំពុងដំណើរការ..."

msgid "Remove"
msgstr "លុប"

msgid "OCR Language"
msgstr "ភាសា OCR"

msgid "OCR PDF"
msgstr "OCR PDF"

msgid "Make Scanned PDFs Searchable"
msgstr "ធ្វើឱ្យ PDF ស្កេនអាចស្វែងរកបាន"

msgid "Upload a scanned PDF or image-based PDF to convert it into a searchable PDF with selectable text. Supports English and Khmer languages."
msgstr "បង្ហាញ PDF ស្កេន ឬ PDF ដោយផ្អែកលើរូបភាព ដើម្បីបំលែងទៅជា PDF ដែលអាចស្វែងរកបាន គាំទ្រភាសាអង់គ្លេស និង ខ្មែរ"

msgid "👆 Upload a PDF to preview"
msgstr "👆 បង្ហាញ PDF ដើម្បីមើល"

msgid "Processing OCR..."
msgstr "កំពុងដំណើរការ OCR..."

msgid "Error loading preview"
msgstr "កំហុសក្នុងការបង្ហាញ"

msgid "Convert to PDF"
msgstr "បម្លែងទៅ PDF"

msgid "👆 Drag images to reorder. They will appear in PDF in this order."
msgstr "👆 អូសរូបភាពដើម្បីតម្រៀប វានឹងលេចឡើងតាមលំដាប់"

msgid "👆 Add images to preview. Drag to reorder."
msgstr "👆 បន្ថែមរូបភាពដើម្បីមើល អូសដើម្បីតម្រៀប"

msgid "Converting images to PDF..."
msgstr "កំពុងបម្លែងរូបភាពទៅ PDF..."

msgid "Format"
msgstr "ទម្រង់"

msgid "Quality (DPI)"
msgstr "គុណភាព (DPI)"

msgid "Convert to Images"
msgstr "បម្លែងទៅរូបភាព"

msgid "👆 Add a PDF file to preview pages and convert to images."
msgstr "👆 បន្ថែមឯកសារ PDF ដើម្បីមើលទំព័រ និងបម្លែងទៅរូបភាព"

msgid "Converting PDF to images..."
msgstr "កំពុងបម្លែង PDF ទៅរូបភាព..."

# --- Upload / Home page ---
msgid "Free Online PDF Tools"
